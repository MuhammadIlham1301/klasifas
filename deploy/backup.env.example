# Konfigurasi backup/restore KlasiFas.
# Salin ke /etc/klasifas/backup.env (atau restore.env untuk staging),
# lalu set kepemilikan root:root dan mode 0600.
# Jangan menyimpan file ini atau nilai secret-nya di repository.

BACKUP_DIR=/var/backups/klasifas
UPLOAD_DIR=/opt/klasifas/uploads
BACKUP_LOCK_FILE=/run/lock/klasifas-backup.lock

# Retensi: jumlah backup harian dan mingguan yang disimpan.
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4

# Opsional. Kosongkan untuk menonaktifkan salinan offsite.
# Contoh: backup@backup-host:/srv/backups/klasifas/
# Gunakan SSH key dan pastikan direktori tujuan sudah ada.
BACKUP_REMOTE=

# Koneksi PostgreSQL untuk backup.
# Password TIDAK diletakkan di sini; gunakan PGPASSFILE.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=klasifas_db
PGUSER=klasifas_backup
PGPASSFILE=/etc/klasifas/.pgpass

# Restore guard: nama database produksi yang tidak boleh ditimpa tanpa
# ALLOW_PRODUCTION_RESTORE=1 dan konfirmasi tambahan.
KLASIFAS_PRODUCTION_DB=klasifas_db

# Restore only: pemilik file uploads setelah restore.
RESTORE_OWNER=klasifas:klasifas
