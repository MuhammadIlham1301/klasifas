# ==============================================================================
# KlasiFas — Konfigurasi Environment Aplikasi (Template Publik)
# ==============================================================================
# PERINGATAN: JANGAN PERNAH MENYIMPAN FILE '.env' ATAU SECRET NYATA KE DALAM GIT!
# ==============================================================================

# Mode Lingkungan: development | testing | production
# Catatan: Wajib disetel eksplisit. Silent fallback ke mode development dilarang.
FLASK_CONFIG=development

# Kunci Rahasia Sesi Kriptografis
# Wajib diisi token heksadesimal tepat 64 karakter (32 bytes).
# Dikosongkan pada template agar tidak ada penggunaan default publik yang lemah.
SECRET_KEY=

# Placeholder Koneksi PostgreSQL (Format dokumentasi SQLAlchemy — BUKAN kredensial aktif)
# Wajib diisi HANYA jika FLASK_CONFIG=production
DATABASE_URL=postgresql+psycopg2://klasifas_user:password_rahasia@localhost:5432/klasifas_db
DEV_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/klasifas_dev_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/klasifas_test_db

# Ambang Batas Keyakinan Klasifikasi Teks Naive Bayes (Placeholder FR-04 / FR-10)
ML_CONFIDENCE_THRESHOLD=0.60

